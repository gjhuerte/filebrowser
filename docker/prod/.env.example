# Copy to .env and adjust:  cp docker/prod/.env.example docker/prod/.env
# Docker Compose reads .env from this folder automatically.

# Host port File Browser is published on
HTTP_PORT=8000

# Folder served by File Browser (mounted at /srv).
# Use a host path (e.g. /srv/files) or a volume name ("files").
# For a host path, set PUID/PGID to the owner of that folder.
FB_FILES_DIR=files

# User/group the app runs as inside the container (baked in at build time)
PUID=1000
PGID=1000

# Image tag and version info embedded in the binary
FB_VERSION=2.63.23
FB_COMMIT=unknown

# Toolchain versions used to build the image
NODE_VERSION=24
GO_VERSION=1.25
ALPINE_VERSION=3.23
