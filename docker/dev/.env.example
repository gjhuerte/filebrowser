# Copy to .env and adjust:  cp docker/dev/.env.example docker/dev/.env
# Docker Compose reads .env from this folder automatically.

# Host ports
VITE_PORT=5173                 # Vite dev server — open http://localhost:<VITE_PORT>
API_PORT=8080                  # Go backend API

# Reverse proxy (e.g. Nginx Proxy Manager) in front of the dev server:
# domains allowed to open it, comma-separated ("*" allows any).
VITE_ALLOWED_HOSTS=

# Folder served by File Browser (mounted at /srv).
# Use a host path (e.g. ~/Documents/Test) or a volume name ("files").
FB_FILES_DIR=files

# Toolchain versions used to build the dev image
NODE_VERSION=24
GO_VERSION=1.27
