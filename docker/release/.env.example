# Copy to .env and adjust:  cp docker/release/.env.example docker/release/.env
# Docker Compose reads .env from this folder automatically.

# Published image to run
#   FB_TAG: v2.63.23 (pinned), v2 (latest 2.x), latest
#           add "-s6" for the s6-overlay variant, e.g. v2.63.23-s6
FB_IMAGE=filebrowser/filebrowser
FB_TAG=v2.63.23

# Host port File Browser is published on
HTTP_PORT=8000

# Folder served by File Browser (mounted at /srv).
# Use a host path (e.g. /srv/files) or a volume name ("files").
FB_FILES_DIR=files

# s6 variant only: user/group to run as, and timezone
PUID=1000
PGID=1000
TZ=UTC
